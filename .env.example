# --- Servidor ---
NODE_ENV=development
# Railway inyecta PORT automáticamente en producción.
PORT=3001

# --- Base de datos ---
# Local: docker compose up -d. En Railway usar ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://gestion:gestion_local@localhost:5432/gestion_proyectos
# true solo si la conexión requiere TLS (p. ej. URL pública de Railway). La red privada de Railway no lo necesita.
DB_SSL=false
DB_LOGGING=false

# --- Autenticación (generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ---
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambiar-por-otro-secreto-largo-y-aleatorio
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS: orígenes permitidos separados por coma. Admite comodín de subdominio: https://*.vercel.app ---
CORS_ORIGINS=http://localhost:3000

# --- Usuario administrador inicial (se crea solo si no existe ningún usuario) ---
ADMIN_NOMBRE=Administrador
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=CambiarEsta123*

# --- Datos de la empresa para los desprendibles ---
EMPRESA_NOMBRE=Empresa de Ingeniería Eléctrica S.A.S.
EMPRESA_NIT=900.000.000-0

# --- Documentación Swagger en /api/docs (por defecto desactivada en producción) ---
SWAGGER_ENABLED=true

# --- Pruebas e2e ---
TEST_DATABASE_URL=postgres://gestion:gestion_local@localhost:5432/gestion_proyectos_test
